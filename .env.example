# =============================================================================
# NutriAgama — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
#
# `.env.local` is gitignored (see .gitignore) — never commit real credentials.
# `.env.example` is safe to commit: it only contains placeholders.
#
# Only NEXT_PUBLIC_* variables are exposed to the browser. Everything else is
# read server-side (API routes / server components) and must stay secret.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (already configured in .env.local — listed here for completeness)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only service role key. Used by the payment API routes because order
# creation, signature verification and webhooks run without a user session
# (and RLS would otherwise reject the writes).
# MUST NOT have a NEXT_PUBLIC_ prefix — never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# -----------------------------------------------------------------------------
# Razorpay — TEST MODE credentials only
# Dashboard: https://dashboard.razorpay.com/app/keys
# -----------------------------------------------------------------------------
# Public key id. Safe to expose to the browser.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX

# Optional override for the client-side checkout script; falls back to
# RAZORPAY_KEY_ID when unset. (Only needed once the checkout UI is added.)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX

# Server only — signs/verifies payment signatures and creates Razorpay orders.
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# Server only — must match the secret configured on the Razorpay webhook.
# Dashboard: Settings > Webhooks > (your webhook) > Secret
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Billing currency used when creating Razorpay orders (default: INR).
RAZORPAY_CURRENCY=INR
